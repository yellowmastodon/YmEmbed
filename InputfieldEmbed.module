<?php

namespace YmEmbed;

use ProcessWire\Inputfield;
use ProcessWire\InputfieldWrapper;
use ProcessWire\Module;
use ProcessWire\WireInputData;

class InputfieldEmbed extends Inputfield implements Module
{
    public static function getModuleInfo()
    {
        return [
            'title'    => 'Embed inputfield',
            'version'  => 1,
            'summary'  => \ProcessWire\__('Oembed style implementation of embed field with preview'),
            'icon'     => 'code',
            'requires' => [
                'PHP>=8.0',
                'FieldtypeEmbed'
            ]
        ];
    }

    public function init()
    {
        require_once(__DIR__ . '/Embed.php');
        require_once(__DIR__ . '/OembedProcessor.php');
    }

    /**
     * Resolves TinyMCE field if installed, falling back to CKEditor or Textarea.
     */
    protected function getDescInputfield(): Inputfield
    {
        $modules = $this->wire('modules');

        if ($modules->isInstalled('InputfieldTinyMCE')) {
            return $modules->get('InputfieldTinyMCE');
        }

        if ($modules->isInstalled('InputfieldCKEditor')) {
            return $modules->get('InputfieldCKEditor');
        }

        return $modules->get('InputfieldTextarea');
    }

    /**
     * '' for the default language, otherwise the language id — the suffix
     * convention used for both Embed data keys and Inputfield::set('valueN', ...).
     */
    private function langSuffix($lang): string
    {
        return $lang->isDefault() ? '' : (string) $lang->id;
    }

    /**
     * Fills a multi-language-capable Inputfield from an Embed's per-language values.
     */
    protected function fillMultilangValue(Inputfield $input, string $prop, Embed $value, $languages): void
    {
        foreach ($languages as $lang) {
            $suffix = $this->langSuffix($lang);
            $val = (string) $value->get("{$prop}{$suffix}", $lang);
            if ($lang->isDefault()) {
                $input->attr('value', $val);
            } else {
                $input->set("value{$lang->id}", $val);
            }
        }
    }

    /**
     * Centralized builder for internal fields.
     */
    protected function getFormWrapper(): InputfieldWrapper
    {
        $modules        = $this->wire('modules');
        $languages      = $this->wire('languages');
        $value          = $this->attr('value') instanceof Embed ? $this->attr('value') : new Embed();
        $name           = $this->name;
        $hasLangSupport = $modules->isInstalled('LanguageSupportFields') && $languages && $languages->count() > 1;

        /** @var InputfieldWrapper $wrapper */
        $wrapper = $modules->get('InputfieldWrapper');
        $wrapper->add($this->buildTitleInput($name, $value, $languages, $hasLangSupport));
        $wrapper->add($this->buildShowTitleInput($name, $value));
        $wrapper->add($this->buildDescriptionInput($name, $value, $languages, $hasLangSupport));

        return $wrapper;
    }

    protected function buildTitleInput(string $name, Embed $value, $languages, bool $hasLangSupport): Inputfield
    {
        $modules = $this->wire('modules');

        /** @var \ProcessWire\InputfieldText $titleInput */
        $titleInput = $modules->get('InputfieldText');
        $titleInput->attr('name', "{$name}_title");
        $titleInput->id("{$name}_title");
        $titleInput->label = $this->_('Title');
        $titleInput->collapsed(Inputfield::collapsedNever);
        $titleInput->set('themeBorder', 'none');
        $titleInput->notes($this->_('Needed for accessibility.'));

        if ($hasLangSupport) {
            $titleInput->useLanguages = true;
            $this->fillMultilangValue($titleInput, 'title', $value, $languages);
        } else {
            $titleInput->attr('value', (string) $value->get('title'));
        }

        return $titleInput;
    }

    protected function buildShowTitleInput(string $name, Embed $value): Inputfield
    {
        $modules = $this->wire('modules');

        /** @var \ProcessWire\InputfieldSelect $showTitleInput */
        $showTitleInput = $modules->get('InputfieldSelect');
        $showTitleInput->attr('name', "{$name}_showtitle");
        $showTitleInput->id("{$name}_showtitle");
        $showTitleInput->label = $this->_('Show title visually?');
        $showTitleInput->attr('value', $value->showtitle ?? FieldtypeEmbed::titleShow);
        $showTitleInput->setOptions([
            FieldtypeEmbed::titleHidden   => $this->_('Hide for sighted users.'),
            FieldtypeEmbed::titleShow     => $this->_('Show under embed.'),
            FieldtypeEmbed::titleSeparate => $this->_('Use separate description.')
        ]);
        $showTitleInput->collapsed(Inputfield::collapsedNever);
        $showTitleInput->set('themeBorder', 'none');
        $showTitleInput->showIf("{$name}_attribution_required=0");

        return $showTitleInput;
    }

    /**
     * Get TinyMCE configuration array for the description inputfield.
     * Hookable to allow easy customization via ready.php or other modules.
     *
     * @return array
     */
    public function ___getTinyMCESettings(): array
    {
        return [
            'inlineMode'        => 1,
            'toolbar'           => 'bold italic strikethrough pwlink code',
            'features'          => ['toolbar', 'stickybars', 'purifier', 'pasteFilter'],
            'newline_behaviour' => 'linebreak',
            'settingsJSON'      => json_encode([
                'forced_root_block'       => 'div',
                'forced_root_block_attrs' => [
                    'data-root' => '',
                ],
                'content_style' => 'body { min-height: 100px !important; }',
            ]),
        ];
    }

    protected function buildDescriptionInput(string $name, Embed $value, $languages, bool $hasLangSupport): Inputfield
    {
        $descInput = $this->getDescInputfield();
        $descInput->attr('name', "{$name}_description");
        $descInput->id("{$name}_description");
        $descInput->label  = $this->_('Description');
        $descInput->rows   = 3;
        $descInput->showIf = "{$name}_showtitle=" . FieldtypeEmbed::titleSeparate;
        $descInput->collapsed(Inputfield::collapsedNever);
        $descInput->set('themeBorder', 'none');
        //dynamically hidden by class
        $descInput->notes($this->_('Attribution required. Do not delete automatically filled author, provider, etc.'));
        
        $settings = $this->getTinyMCESettings();
        $descInput->setArray($settings);
        $descInput->addClass('InputfieldEmbedDescription', 'wrapClass');
        
        bd($value->attribution_required);

        if ($value->attribution_required){
            $this->addClass('InputfieldEmbedAttributionRequired', 'wrapClass');
            bd($this);
        }

        if ($hasLangSupport) {
            $descInput->useLanguages = true;
            $this->fillMultilangValue($descInput, 'description', $value, $languages);
        } else {
            $descInput->attr('value', (string) $value->get('description'));
        }

        return $descInput;
    }

    public function renderReady(?Inputfield $parent = null, $renderValueMode = false)
    {
        $url  = $this->config->urls->{$this->className};
        $path = $this->config->paths->{$this->className};

        $cssFile = $path . 'InputfieldEmbed.css';
        $jsFile  = $path . 'InputfieldEmbed.js';
        $cssVer  = file_exists($cssFile) ? filemtime($cssFile) : time();
        $jsVer   = file_exists($jsFile)  ? filemtime($jsFile)  : time();

        $this->config->styles->add($url . "InputfieldEmbed.css?mod={$cssVer}");
        $this->config->scripts->add($url . "InputfieldEmbed.js?mod={$jsVer}");
        $this->config->jsConfig($this->className, ['ajaxUrl' => $this->ajaxUrl]);
    }

    public function ___render()
    {
        
        $value = $this->attr('value') instanceof Embed ? $this->attr('value') : new Embed();
        
        //guard attribution required. if required, show description always.
        if ($value->attribution_required){
            $value->showtitle = FieldtypeEmbed::titleSeparate;
        }

        $name  = $this->name;
        $this->wrapAttr('data-id', $name);

        $preview = $value->render();
        $this->previewAvailable = !empty($preview);

        $out  = $this->renderTabs($name, $value, $preview);
        $out .= $this->getFormWrapper()->render();
        $out .= $this->renderHiddenInputs($name, $value);
        $out .= '<div class="InputfieldEmbed__overlay" hidden></div><div class="InputfieldEmbed__spinner" uk-spinner hidden></div>';

        return $out;
    }

    /**
     * Builds the URL / HTML / Preview tab UI, including the URL and HTML inputfields.
     */
    protected function renderTabs(string $name, Embed $value, string $preview): string
    {
        $modules = $this->wire('modules');

        /** @var \ProcessWire\InputfieldURL $urlInput */
        $urlInput = $modules->get('InputfieldURL');
        $urlInput->attr('name', "{$name}[src_url]");
        $urlInput->id("{$name}_src_url");
        $urlInput->attr('value', $value->src_url ?? $value->url ?? '');
        $urlInput->attr('aria-labelledby', "{$name}__tab-link--src-url");
        $urlInput->class('InputfieldEmbed__src_url');

           $tabContainerID = $name . '__tab-container';
        $tabsHtml  = '<ul class="uk-text-small uk-margin-remove" uk-tab="connect:#' . $tabContainerID . '">';
        $tabsHtml .= '<li' . (!$this->previewAvailable ? ' class="uk-active"' : '') . '><a id="' . $name . '__tab-link--src-url" href="#"><i class="fa fw fa-link"></i> ' . $this->_('URL') . '</a></li>';
        $tabsHtml .= '<li class="embed-preview-tab ' . ($this->previewAvailable ? 'uk-active ' : '') . '"><a href="#"><i class="fa fw fa-play-circle-o"></i> ' . $this->_('Preview') . '</a></li>';
        $tabsHtml .= '</ul>';

        $tabsHtml .= "<ul id='{$tabContainerID}' class='uk-switcher uk-margin-small-top'>";
        $tabsHtml .= "  <li class='uk-inline uk-width-1-1'>" . $urlInput->render() . '<button type="button" class="InputfieldEmbed__src-url-button uk-form-icon uk-form-icon-flip" aria-label="' . $this->_('Reload') . '" id="' . $name . '_src-url-button"' . (!$this->previewAvailable ? ' hidden' : '') . '><i class="fa fw fa-refresh"></i></button></li>';
        $tabsHtml .= '<li><div class="embed-preview"><span class="embed-preview__message"' . ($this->previewAvailable ? ' hidden' : '') .  '>' . $this->_('No preview available.') . '</span>' . ($this->previewAvailable ? $preview : '') . '</div></li>';
        $tabsHtml .= '</ul>';

        return $tabsHtml;
    }

    protected function renderHiddenInputs(string $name, Embed $value): string
    {
        $sanitizer  = $this->wire('sanitizer');
        $languages  = $this->wire('languages');
        $hiddenHtml = '';

        foreach (Embed::SCHEMA as $prop => $meta) {
            if (in_array($prop, ['src_url', 'description', 'title', 'showtitle'], true)) continue;
            if ($meta['db'] === null && $prop !== 'width' && $prop !== 'height') continue;

            $langs = (!empty($meta['multilang']) && $languages) ? $languages : [null];

            foreach ($langs as $lang) {
                $key = $lang ? "{$prop}{$this->langSuffix($lang)}" : $prop;
                $val = $lang ? $value->get($key, $lang) : $value->get($key);
                //if ($prop === 'attribution_required') $val = 1;
                $hiddenHtml .= sprintf(
                    '<input type="hidden" name="%s" id="%s" value="%s">',
                    $sanitizer->entities("{$name}[{$key}]"),
                    $sanitizer->entities("{$name}_{$key}"),
                    $sanitizer->entities((string) $val)
                );
            }
        }

        $hiddenHtml .= sprintf(
            '<input type="hidden" name="%s" id="%s" value="%s">',
            $sanitizer->entities("{$name}[processed]"),
            $sanitizer->entities("{$name}_processed"),
            $this->previewAvailable ? 1 : 0
        );

        return $hiddenHtml;
    }

public function ___processInput(WireInputData $input)
    {
        $name           = $this->name;
        $data           = $input[$name] ?? [];
        $modules        = $this->wire('modules');
        $languages      = $this->wire('languages');
        $hasLangSupport = $modules->isInstalled('LanguageSupportFields') && $languages && $languages->count() > 1;

        if (!is_array($data)) {
            $data = [];
        }

        // 1. Process internal wrapper for select/options inputs
        $wrapper = $this->getFormWrapper();
        $wrapper->processInput($input);

        $showTitleInput    = $wrapper->getChildByName("{$name}_showtitle");
        $data['showtitle'] = $showTitleInput ? ($showTitleInput->val() ?: $showTitleInput->attr('value')) : ($data['showtitle'] ?? FieldtypeEmbed::titleShow);

        // 2. Extract title & description directly from input
        $data = array_merge(
            $data,
            $this->extractLangField($input, $name, 'title', $languages, $hasLangSupport),
            $this->extractLangField($input, $name, 'description', $languages, $hasLangSupport)
        );

        $previousValue = $this->attr('value') instanceof Embed ? $this->attr('value') : new Embed();

        // 3. Process URL & oEmbed fetch ONLY if 'processed' is not true
        if (empty($data['processed'])) {
            return $this->processUrlAndFetch($data, $previousValue);
        }

        // 'processed' is true: Save submitted values directly without re-fetching oEmbed
        $value      = new Embed($data);
        $hasChanged = serialize($previousValue->getArray()) !== serialize($value->getArray());

        if ($hasChanged) {
            $this->setAttribute('value', $value);
            $this->trackChange('value', $previousValue, $value);
        }

        return $this;
    }

   /**
     * Pulls raw language inputs directly from WireInputData.
     * Sanitization is deferred to Fieldtype::sanitizeValue().
     */
    protected function extractLangField(
        WireInputData $input,
        string $name,
        string $field,
        $languages,
        bool $hasLangSupport
    ): array {
        $out   = [];
        $langs = $hasLangSupport ? $languages : [null];

        foreach ($langs as $lang) {
            $suffix  = ($lang && !$lang->isDefault()) ? (string) $lang->id : '';
            $postKey = $suffix ? "{$name}_{$field}__{$suffix}" : "{$name}_{$field}";
            $val = (string) ($input[$postKey] ?? '');

            if ($field === 'description'){
                $val = $this->cleanDescriptionHtml($val);
            }

            $out["{$field}{$suffix}"] = $val;
        }

        return $out;
    }

    /**
     * Strips auto-generated TinyMCE root wrapper tag (e.g. <div data-root="">...</div>)
     * while preserving all inner HTML tags (e.g. <strong>, <a>, <em>).
     */
    protected function cleanDescriptionHtml(string $html): string
    {
        $trimmed = trim($html);
        if ($trimmed === '') return '';

        // Strip outer <... data-root> wrapper, preserving all inner HTML
        return preg_replace('/^<([a-z0-9]+)\b[^>]*\bdata-root\b[^>]*>(.*)<\/\1>$/is', '$2', $trimmed);
    }

    /**
     * Validates the submitted URL, fetches oEmbed data when the URL changed,
     * and saves the resulting Embed value.
     */
    protected function processUrlAndFetch(array $data, $previousValue)
    {
        $rawUrl = trim($data['src_url'] ?? $data['url'] ?? '');

        if ($rawUrl === '') {
            $blankValue = new Embed();
            if (serialize($previousValue->getArray()) !== serialize($blankValue->getArray())) {
                $this->setAttribute('value', $blankValue);
                $this->trackChange('value', $previousValue, $blankValue);
            }
            return $this;
        }

        $sanitizer = $this->wire('sanitizer');
        $validUrl  = $sanitizer->httpUrl($rawUrl, ['throw' => false]);
        $host      = parse_url($validUrl, PHP_URL_HOST);

        if (empty($validUrl) || !$host || !str_contains($host, '.')) {
            $this->error(
                sprintf(
                    $this->_('Embed URL error: "%s" is not a valid web URL.'),
                    $sanitizer->entities($rawUrl)
                )
            );
            return $this;
        }

        $urlChanged = ($previousValue instanceof Embed) && ($previousValue->src_url !== $validUrl && $previousValue->url !== $validUrl);

        if ($urlChanged && empty($data['html'])) {
            $processor   = new OembedProcessor();
            $fetchedData = $processor->fetch($validUrl);

            if (!$fetchedData || empty($fetchedData['html'])) {
                $this->error(
                    sprintf(
                        $this->_('Could not retrieve oEmbed data from URL: "%s". Check if the URL is publicly accessible.'),
                        $sanitizer->entities($validUrl)
                    )
                );
                return $this;
            }

            $data = array_merge($data, $fetchedData);
        }

        $value      = new Embed($data);
        $hasChanged = serialize($previousValue->getArray()) !== serialize($value->getArray());

        if ($hasChanged) {
            $this->setAttribute('value', $value);
            $this->trackChange('value', $previousValue, $value);
        }

        return $this;
    }
}